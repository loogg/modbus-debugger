{
  "schemaVersion": 1,
  "name": "工业混合调试工作区 (TCP + RTU COM1)",
  "connections": [
    {
      "id": "conn-tcp",
      "name": "生产线 TCP",
      "transport": "tcp",
      "tcp": {
        "host": "127.0.0.1",
        "port": 50520
      },
      "timeoutMs": 800,
      "retries": 1,
      "reconnect": "auto",
      "interFrameMs": 0,
      "rtsControl": "none",
      "logLevel": "info"
    },
    {
      "id": "conn-rtu",
      "name": "现场总线 RTU (COM1 115200)",
      "transport": "rtu",
      "rtu": {
        "port": "COM1",
        "baudRate": 115200,
        "dataBits": 8,
        "parity": "none",
        "stopBits": 1
      },
      "timeoutMs": 1000,
      "retries": 2,
      "reconnect": "auto",
      "interFrameMs": 4,
      "rtsControl": "none",
      "logLevel": "info"
    }
  ],
  "slaves": [
    {
      "id": "slave-1",
      "connectionId": "conn-tcp",
      "unitId": 1,
      "name": "伺服驱动器 A",
      "templateId": "tpl-servo",
      "enabled": true
    },
    {
      "id": "slave-rtu-1",
      "connectionId": "conn-rtu",
      "unitId": 1,
      "name": "流量变送器 (COM1)",
      "templateId": "tpl-flow",
      "enabled": true
    }
  ],
